# =====================================================================
#  Copier ce fichier en .env (jamais commité : voir .gitignore)
#      cp .env.example .env
#  puis remplacer les valeurs <...>. Voir README_GITHUB_DVC_MLFLOW.md.
# =====================================================================

# --- Dépôt DagsHub connecté au dépôt GitHub --------------------------
DAGSHUB_USER=ayoubenet
DAGSHUB_REPO=cours-mlops
# Token : DagsHub > Settings > Tokens (ou bouton "Remote" du dépôt)
DAGSHUB_TOKEN=8122d187ee88745788ac25b5142949100b353d16



# --- MLflow (lu directement par la bibliothèque mlflow) ---------------
# Laisser MLFLOW_TRACKING_URI vide ou commenté pour un suivi 100 % local
# (fichier mlflow.db + dossier mlruns/ à la racine du dépôt).
MLFLOW_TRACKING_URI=https://dagshub.com/ayoubenet/cours-mlops.mlflow
MLFLOW_TRACKING_USERNAME=ayoubenet
MLFLOW_TRACKING_PASSWORD=8122d187ee88745788ac25b5142949100b353d16
MLFLOW_EXPERIMENT_NAME=fraud_detection
MLFLOW_REGISTERED_MODEL=Fraud_Detection_Production

# --- Options des notebooks --------------------------------------------
# QUICK_RUN=1 : démonstration rapide (moins de modèles réglés, pas d'ensembles)
QUICK_RUN=0
# RUN_TUNING=1
# RUN_ENSEMBLES=1
# N_ITER=15
# TUNING_MAX_ROWS=200000
# REBUILD_SUBSET=1 : le notebook 02 régénère fraud_600k.csv depuis fraud_1M.csv
# REBUILD_SUBSET=0
